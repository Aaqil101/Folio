; Folio installer — Inno Setup 7 script (issue #14).
;
; Build with installer/build.ps1, which passes the version from
; utils/constants.py. Compiling this file directly with ISCC also works —
; the #ifndef fallbacks below supply a default version.

#define MyAppName "Folio"
#ifndef MyAppVersion
  #define MyAppVersion "0.1.0"
#endif
#ifndef MyAppPublisher
  #define MyAppPublisher "Aaqil"
#endif
#ifndef MyAppURL
  #define MyAppURL "https://github.com/Aaqil101/Folio"
#endif
#define MyAppExeName "Folio.exe"

[Setup]
; AppUserModelId-style stable AppId: changing this string makes Windows treat
; a new build as a different product (parallel installs, duplicate entries).
AppId={{8F3C1A54-6E9B-4D27-B14A-3C7D90E2F6A8}

AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}/issues
VersionInfoVersion={#MyAppVersion}
VersionInfoProductVersion={#MyAppVersion}
VersionInfoProductName={#MyAppName}
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
LicenseFile=..\LICENSE
OutputDir=..\dist\installer
OutputBaseFilename=Folio-Setup-{#MyAppVersion}
SetupIconFile=..\assets\application\folio.ico
UninstallDisplayIcon={app}\{#MyAppExeName}
UninstallDisplayName={#MyAppName}
Compression=lzma2/max
SolidCompression=yes
; If Folio (or anything holding installed files) is running when a new
; version installs, stop on the Preparing to Install page and ask to close
; it (Windows Restart Manager) instead of failing on locked files.
CloseApplications=yes
; modern layout + dark mode: 'dynamic' follows the user's Windows appearance
; (dark on dark systems, light on light); use 'dark' here to force dark for
; everyone instead. Applies to Setup and Uninstall.
WizardStyle=modern dynamic
; Wizard branding: flat background color per appearance (also paints the
; language dialog and Uninstall) with the folio book glyph watermarked on
; wizard pages. Artwork is transparent PNGs generated by
; installer\generate_wizard_images.py; the side panel bitmaps are Inno's
; defaults - blanked so only the background art shows.
WizardBackColor=#f3f3f3
WizardBackColorDynamicDark=#282828
WizardBackImageFile=wizard-back-light.png
WizardBackImageFileDynamicDark=wizard-back-dark.png
WizardImageFile=
WizardSmallImageFile=wizard-small.png
; A short guide shown on its own wizard page after a successful install.
InfoAfterFile=getting-started.txt
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
; Machine-wide install is the default/recommended mode (UAC elevation); the
; dialog still offers a per-user install as the alternative.
PrivilegesRequired=admin
PrivilegesRequiredOverridesAllowed=dialog

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; The whole PyInstaller onedir tree: Folio.exe + _internal/.
Source: "..\dist\Folio\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#MyAppName}}"; Flags: nowait postinstall skipifsilent

[UninstallDelete]
; Type files/folders here to delete them on uninstall. Settings in
; %APPDATA%\Folio\ are deliberately kept — user data survives removal.
